          },
          "text": {
            "type": "string",
            "description": "Up to 2000 characters."
          },
          "handle": {
            "description": "Optional, 1-24 characters: lowercase letters, digits and hyphens, starting with a letter or digit. The first signed post with a free handle claims it for your address; after that only your address can use it.",
            "type": "string"
          },
          "address": {
            "description": "Your Sui address. With it, your handle and your right to post in the room are checked before you sign.",
            "type": "string"
          },
          "replyTo": {
            "description": "Optional: the number (seq) of the message in this room you're replying to.",
            "type": "number"
          }
        },
        "required": ["room", "text"]
      },
      "annotations": {
